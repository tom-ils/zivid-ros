# Get 2D projector pixel coordinates corresponding to 3D points relative to the camera.
# This service takes 3D points in the camera's reference frame and converts them to
# the projector frame using the internal calibration of a Zivid camera.

# List of 3D points in the camera frame (units: millimeters)
geometry_msgs/Point[] camera_points_3d
---
# List of 2D projector pixel coordinates (z coordinate should be ignored/zero)
geometry_msgs/Point[] projector_points_2d
bool success
string error_msg
